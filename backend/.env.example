# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moviefilm_db
DB_USERNAME=your_username
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=86400000

# Server
SERVER_PORT=8080
